<?xml version="1.0"?>
<Container version="2">
  <Name>zapconvert-gotenberg</Name>
  <Repository>gotenberg/gotenberg:8</Repository>
  <Registry>https://hub.docker.com/r/gotenberg/gotenberg</Registry>
  <Network>zapconvert</Network>
  <MyIP/>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/zapconvert/zapconvert/issues</Support>
  <Project>https://gotenberg.dev</Project>
  <Overview>Office document conversion (Word, PowerPoint, Excel, ODT and RTF to PDF) for ZapConvert, using LibreOffice. It has no published port: only containers on the zapconvert network can reach it. Working files stay in RAM.</Overview>
  <Category>Productivity: Tools:Utilities</Category>
  <WebUI/>
  <TemplateURL>https://raw.githubusercontent.com/zapconvert/unraid-templates/main/zapconvert-gotenberg.xml</TemplateURL>
  <Icon>https://zapconvert.app/brand/icon-512.png</Icon>
  <ExtraParams>--restart=unless-stopped --tmpfs /tmp:size=1024m,mode=1777</ExtraParams>
  <PostArgs>gotenberg --api-timeout=120s --libreoffice-auto-start=true --chromium-disable-routes=true --log-level=error</PostArgs>
  <CPUset/>
  <DonateText/>
  <DonateLink/>
  <Requires>Create the network once in the Unraid terminal: docker network create zapconvert</Requires>
</Container>
